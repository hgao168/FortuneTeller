/* 全局样式：与 iOS 端深色趣味主题保持一致 */
page {
  background: linear-gradient(160deg, #1a0f2e 0%, #2a1545 45%, #3a1a55 100%);
  min-height: 100vh;
  color: #f5f3ff;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 32rpx 28rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 24rpx 28rpx;
}

.hero-emoji {
  font-size: 96rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(245, 243, 255, 0.72);
}

.card {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 28rpx;
  padding: 28rpx 26rpx;
  margin: 20rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 14rpx;
}

.card-text {
  font-size: 28rpx;
  color: rgba(245, 243, 255, 0.85);
}

.muted {
  color: rgba(245, 243, 255, 0.6);
  font-size: 24rpx;
}

.btn-primary {
  background: linear-gradient(120deg, #ff8a3d 0%, #ff5b9a 50%, #6cd0ff 100%) !important;
  color: #fff !important;
  font-weight: 600;
  border-radius: 999rpx !important;
  padding: 22rpx 0 !important;
  font-size: 30rpx !important;
  border: none !important;
  box-shadow: 0 10rpx 26rpx rgba(255, 91, 154, 0.35);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.12) !important;
  color: #fff !important;
  border: 1rpx solid rgba(255, 255, 255, 0.2) !important;
  border-radius: 999rpx !important;
  padding: 22rpx 0 !important;
  font-size: 28rpx !important;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.btn-row > button {
  flex: 1;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 14rpx 0;
}

.chip {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  font-size: 26rpx;
  color: #fff;
}

.chip-active {
  background: linear-gradient(120deg, #ff8a3d, #ff5b9a);
  border-color: transparent;
  font-weight: 600;
}

.chip-pink {
  background: linear-gradient(120deg, #ff5b9a, #ff8fb1);
  border-color: transparent;
  color: #fff;
}

.chip-blue {
  background: linear-gradient(120deg, #4aa6ff, #6cd0ff);
  border-color: transparent;
  color: #fff;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 28rpx 0 10rpx;
  color: #fff;
}

.label {
  font-size: 26rpx;
  color: rgba(245, 243, 255, 0.7);
  margin-bottom: 8rpx;
}

.preview {
  width: 100%;
  height: 420rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx dashed rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.preview image {
  width: 100%;
  height: 100%;
}

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
  margin: 24rpx 0;
}

.score-badge {
  display: inline-block;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(120deg, #ff8a3d, #ff5b9a, #6cd0ff);
}

.disclaimer {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 18rpx;
  font-size: 22rpx;
  color: rgba(245, 243, 255, 0.6);
  line-height: 1.6;
}
